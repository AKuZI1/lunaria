<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/>
    </Style>

    <Style Selector="Button.nav-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Margin" Value="4,2"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
    </Style>
    <Style Selector="Button.nav-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
    </Style>
    <Style Selector="Button.nav-btn.active">
        <Setter Property="Background" Value="#7C3AED"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Border.stat-card, Border.panel">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,12,12"/>
    </Style>

    <Style Selector="ProgressBar.purple">
        <Setter Property="Foreground" Value="#7C3AED"/>
    </Style>
    <Style Selector="ProgressBar.blue">
        <Setter Property="Foreground" Value="#3B82F6"/>
    </Style>
    <Style Selector="ProgressBar.green">
        <Setter Property="Foreground" Value="#10B981"/>
    </Style>

    <!-- Бейджи -->
    <Style Selector="Border.badge-design">
        <Setter Property="Background" Value="#EDE9FE"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style Selector="Border.badge-design TextBlock">
        <Setter Property="Foreground" Value="#7C3AED"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Border.badge-dev">
        <Setter Property="Background" Value="#DBEAFE"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style Selector="Border.badge-dev TextBlock">
        <Setter Property="Foreground" Value="#2563EB"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Border.badge-marketing">
        <Setter Property="Background" Value="#D1FAE5"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style Selector="Border.badge-marketing TextBlock">
        <Setter Property="Foreground" Value="#059669"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
</Styles>