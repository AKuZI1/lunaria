<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaApplication1.Views.ProjectsView">
    <StackPanel Spacing="24">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="TitleText" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button x:Name="NewProjectBtn" 
                    Grid.Column="1"
                    Background="#7C3AED" 
                    Foreground="White"
                    CornerRadius="8" 
                    Padding="16,10"
                    FontSize="14"
                    FontWeight="SemiBold"
                    IsEnabled="False"
                    VerticalAlignment="Center"/>
        </Grid>        <Grid ColumnDefinitions="*,*,*">
            <Border Grid.Column="0" Classes="panel">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="P1Title" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="P1Desc" Foreground="Gray" FontSize="13"/>
                    <ProgressBar Value="65" Classes="purple" Height="8" Margin="0,12,0,0"/>
                    <TextBlock x:Name="P1Progress" FontSize="13" Foreground="Gray" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="panel">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="P2Title" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="P2Desc" Foreground="Gray" FontSize="13"/>
                    <ProgressBar Value="40" Classes="blue" Height="8" Margin="0,12,0,0"/>
                    <TextBlock x:Name="P2Progress" FontSize="13" Foreground="Gray" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="panel">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="P3Title" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="P3Desc" Foreground="Gray" FontSize="13"/>
                    <ProgressBar Value="80" Classes="green" Height="8" Margin="0,12,0,0"/>
                    <TextBlock x:Name="P3Progress" FontSize="13" Foreground="Gray" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>