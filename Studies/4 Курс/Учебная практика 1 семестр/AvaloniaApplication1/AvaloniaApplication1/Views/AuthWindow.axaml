<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaApplication1.AuthWindow"
        Title="Project Studio"
        Width="420" Height="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">

    <StackPanel Margin="40" VerticalAlignment="Center" Spacing="16">
        <StackPanel HorizontalAlignment="Center" Spacing="8">
            <Border Width="56" Height="56" CornerRadius="14" Background="#7C3AED" HorizontalAlignment="Center"/>
            <TextBlock Text="Project Studio" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="SubtitleText" FontSize="13" Foreground="Gray" HorizontalAlignment="Center"/>
        </StackPanel>

        <TextBlock x:Name="LblFio" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,4"/>
        <TextBox Name="txtFullName" Watermark="Иван Петров" Padding="12,10" CornerRadius="8"/>

        <TextBlock x:Name="LblPass" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,4"/>
        <TextBox Name="txtPassword" PasswordChar="●" Watermark="••••••••" Padding="12,10" CornerRadius="8"/>

        <TextBlock Name="txtError" Foreground="#EF4444" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>

        <Button Name="btnLogin" Content="Войти" Click="Login_Click"
                Background="#7C3AED" Foreground="White"
                Padding="12,12" CornerRadius="8" FontSize="15" FontWeight="SemiBold"
                HorizontalAlignment="Stretch" Margin="0,12,0,0"/>
    </StackPanel>
</Window>